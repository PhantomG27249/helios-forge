{
  "name": "helios-forge",
  "version": "1.0.0",
  "description": "Helios Forge: an AlphaHelion research-agent workbench for Pi",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "vendor:sync": "node scripts/sync-vendor-assets.js",
    "postinstall": "node scripts/sync-vendor-assets.js",
    "electron": "electron src/electron/main.js",
    "electron:pack": "npm run vendor:sync && electron-builder --dir --config electron-builder.yml",
    "electron:dist": "npm run vendor:sync && electron-builder --config electron-builder.yml",
    "icons:generate": "node scripts/generate-app-icons.js",
    "test": "node --test",
    "setup": "node scripts/setup-helios-forge.js",
    "install:helios": "node scripts/setup-helios-forge.js",
    "release:smoke": "node scripts/release-smoke.js",
    "publish:check": "node scripts/publish-preflight.js",
    "install:pi-kwargs": "node scripts/install-pi-kwargs-extension.js",
    "install:pi-helios": "node scripts/install-pi-helios-extension.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.10.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "marked": "^15.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
